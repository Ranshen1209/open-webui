# Sakrylle Web - Environment Configuration
# Copy to /opt/stack/sakrylle-web/.env and set mode 600
# Production target: Sakrylle OIDC SSO-only with a confidential client.

####################################
# Core (REQUIRED)
####################################
WEBUI_SECRET_KEY=CHANGE_ME_TO_RANDOM_32_BYTES
WEBUI_AUTH=True
DATA_DIR=/app/backend/data
WEBUI_URL=https://chat.sakrylle.com

####################################
# Brand
####################################
WEBUI_NAME=Sakrylle Web

####################################
# Sakrylle API Connection
####################################
OPENAI_API_BASE_URLS=https://api.sakrylle.com/v1
OPENAI_API_KEYS=
# auth_type=system_oauth -> each request forwards the logged-in user's own OAuth
# access token. model_list_query adds ?groups=all so GET /v1/models returns every
# group the user can access (each model carries group:{id,name,rate_multiplier});
# without it the gateway only returns the authorize-flow default group. The Sakrylle
# model-group selector in the frontend depends on this multi-group response.
OPENAI_API_CONFIGS={"0":{"auth_type":"system_oauth","model_list_query":{"groups":"all"}}}
ENABLE_OLLAMA_API=False
ENABLE_OPENAI_API=True

####################################
# Auth - Sakrylle OIDC SSO-only
####################################
ENABLE_LOGIN_FORM=False
ENABLE_SIGNUP=False
ENABLE_OAUTH_SIGNUP=True
DEFAULT_USER_ROLE=user
OAUTH_AUTO_REDIRECT=True
OAUTH_PROVIDER_NAME=Sakrylle SSO
OAUTH_CLIENT_ID=sakrylle-web
OAUTH_CLIENT_SECRET=CHANGE_ME_TO_CONFIDENTIAL_CLIENT_SECRET
OPENID_PROVIDER_URL=https://sub.sakrylle.com/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://chat.sakrylle.com/oauth/oidc/login/callback
OAUTH_SCOPES=openid email profile models:read chat.completions:create responses:create messages:create usage:read offline_access
OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
OAUTH_CODE_CHALLENGE_METHOD=S256
OAUTH_EMAIL_CLAIM=email
OAUTH_USERNAME_CLAIM=name
# Optional if discovery does not expose end_session_endpoint:
# OPENID_END_SESSION_ENDPOINT=https://sub.sakrylle.com/oauth/logout
WEBUI_AUTH_SIGNOUT_REDIRECT_URL=https://chat.sakrylle.com/auth

####################################
# Cookies / sessions (HTTPS production)
####################################
WEBUI_SESSION_COOKIE_SECURE=True
WEBUI_AUTH_COOKIE_SECURE=True
# Optional: separate OAuth token encryption from WEBUI_SECRET_KEY.
# OAUTH_SESSION_TOKEN_ENCRYPTION_KEY=CHANGE_ME_TO_RANDOM_32_BYTES

####################################
# Admin (first-run only; disabled after first admin exists)
####################################
WEBUI_ADMIN_EMAIL=admin@sakrylle.com
WEBUI_ADMIN_PASSWORD=CHANGE_ME
WEBUI_ADMIN_NAME=Sakrylle Admin

####################################
# Misc
####################################
ENABLE_COMMUNITY_SHARING=False
ENABLE_VERSION_UPDATE_CHECK=False

####################################
# File upload (retrieval router, bypass mode)
####################################
# Mounts the retrieval router so users can upload files in chat. Without this the
# "+" menu only shows Capture/screenshot (all upload items gate on
# features.enable_retrieval, which maps to this flag). Defaults stay lightweight:
# BYPASS_EMBEDDING_AND_RETRIEVAL=True (full-context inject, no embeddings) and
# VECTOR_DB='' (NoOp backend) — no chromadb/torch load, safe on the slim image.
# The server compose uses env_file only (no environment: block), so this MUST live
# in .env to reach the container.
SAKRYLLE_ENABLE_RETRIEVAL_ROUTER=True

# Web search (DuckDuckGo). Rides on the retrieval router above (so that must be
# True). ENABLE_WEB_SEARCH turns it on; WEB_SEARCH_ENGINE picks the backend
# (duckduckgo needs no API key). BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=True
# injects fetched page content straight into context with no embedding/vector DB,
# so it stays safe on the slim image (no chromadb/torch). Verified end-to-end on
# the slim image 2026-06-13 (search + web-loader page fetch both work). Like the
# other flags, this MUST live in .env (compose uses env_file only). It is read
# from /api/config, so an open session just needs a page refresh for the chat
# web-search toggle to appear — no re-login (the JWT is unaffected).
ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=duckduckgo
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=True
