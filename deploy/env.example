# Sakrylle Web - Environment Configuration
# Copy to /opt/stack/sakrylle-web/.env and set mode 600
# Production target: Sakrylle OIDC SSO-only with a confidential client.

####################################
# Core (REQUIRED)
####################################
WEBUI_SECRET_KEY=CHANGE_ME_TO_RANDOM_32_BYTES
WEBUI_AUTH=True
DATA_DIR=/app/backend/data
WEBUI_URL=https://chat.sakrylle.com

####################################
# Brand
####################################
WEBUI_NAME=Sakrylle Web

####################################
# Sakrylle API Connection
####################################
OPENAI_API_BASE_URLS=https://api.sakrylle.com/v1
OPENAI_API_KEYS=
OPENAI_API_CONFIGS={"0":{"auth_type":"system_oauth"}}
ENABLE_OLLAMA_API=False
ENABLE_OPENAI_API=True

####################################
# Auth - Sakrylle OIDC SSO-only
####################################
ENABLE_LOGIN_FORM=False
ENABLE_SIGNUP=False
ENABLE_OAUTH_SIGNUP=True
DEFAULT_USER_ROLE=user
OAUTH_AUTO_REDIRECT=True
OAUTH_PROVIDER_NAME=Sakrylle SSO
OAUTH_CLIENT_ID=sakrylle-web
OAUTH_CLIENT_SECRET=CHANGE_ME_TO_CONFIDENTIAL_CLIENT_SECRET
OPENID_PROVIDER_URL=https://sub.sakrylle.com/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://chat.sakrylle.com/oauth/oidc/login/callback
OAUTH_SCOPES=openid email profile models:read chat.completions:create responses:create messages:create usage:read offline_access
OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
OAUTH_CODE_CHALLENGE_METHOD=S256
OAUTH_EMAIL_CLAIM=email
OAUTH_USERNAME_CLAIM=name
# Optional if discovery does not expose end_session_endpoint:
# OPENID_END_SESSION_ENDPOINT=https://sub.sakrylle.com/oauth/logout
WEBUI_AUTH_SIGNOUT_REDIRECT_URL=https://chat.sakrylle.com/auth

####################################
# Cookies / sessions (HTTPS production)
####################################
WEBUI_SESSION_COOKIE_SECURE=True
WEBUI_AUTH_COOKIE_SECURE=True
# Optional: separate OAuth token encryption from WEBUI_SECRET_KEY.
# OAUTH_SESSION_TOKEN_ENCRYPTION_KEY=CHANGE_ME_TO_RANDOM_32_BYTES

####################################
# Admin (first-run only; disabled after first admin exists)
####################################
WEBUI_ADMIN_EMAIL=admin@sakrylle.com
WEBUI_ADMIN_PASSWORD=CHANGE_ME
WEBUI_ADMIN_NAME=Sakrylle Admin

####################################
# Misc
####################################
ENABLE_COMMUNITY_SHARING=False
